# ==========================================
# Tuntas & Full-Stack Monorepo .gitignore
# ==========================================

# ------------------------------------------
# Environment & Local Secrets
# ------------------------------------------
.env
.env.backup
.env.production
.env.local
.env.*.local
.env.testing

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
*/node_modules/
vendor/
*/vendor/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Next.js & Frontend Build Outputs
# ------------------------------------------
.next/
*/.next/
dist/
*/dist/
out/
*/out/
build/
*/build/
.tsbuildinfo
*.tsbuildinfo

# ------------------------------------------
# Laravel Storage, Cache & Framework Artifacts
# ------------------------------------------
*.log
storage/*.key
storage/pail/
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/logs/*.log
!storage/logs/.gitignore

apps/api/storage/*.key
apps/api/storage/pail/
apps/api/storage/framework/cache/data/*
!apps/api/storage/framework/cache/data/.gitignore
apps/api/storage/framework/sessions/*
!apps/api/storage/framework/sessions/.gitignore
apps/api/storage/framework/views/*
!apps/api/storage/framework/views/.gitignore
apps/api/storage/framework/testing/*
!apps/api/storage/framework/testing/.gitignore
apps/api/storage/logs/*.log
!apps/api/storage/logs/.gitignore

# ------------------------------------------
# Database Local Files
# ------------------------------------------
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
database/*.sqlite
apps/api/database/*.sqlite
apps/api/database/*.sqlite-journal
apps/api/database/*.sqlite-wal
apps/api/database/*.sqlite-shm

# ------------------------------------------
# Public & Build Assets
# ------------------------------------------
public/build/
public/hot
public/storage
apps/api/public/build/
apps/api/public/hot
apps/api/public/storage

# ------------------------------------------
# Testing & Cache Artifacts
# ------------------------------------------
.phpunit.result.cache
.phpunit.cache/
apps/api/.phpunit.result.cache
apps/api/.phpunit.cache/
coverage/
*/coverage/

# ------------------------------------------
# IDEs, Editors & OS Files
# ------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.fleet/
.nova/
.zed/
.phpactor.json
auth.json
Homestead.json
Homestead.yaml
