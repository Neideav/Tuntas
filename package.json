{
  "name": "tuntas",
  "version": "2.0.0",
  "private": true,
  "description": "Tuntas — Integrated Full-Stack Productivity, LMS & Examination Platform",
  "scripts": {
    "clean:next": "node -e \"const fs = require('fs'); ['src/.next', '.next'].forEach(p => { if (fs.existsSync(p)) fs.rmSync(p, { recursive: true, force: true }); });\"",
    "predev": "node -e \"const fs = require('fs'); ['src/.next', '.next'].forEach(p => { if (fs.existsSync(p)) fs.rmSync(p, { recursive: true, force: true }); });\"",
    "dev": "concurrently -c \"cyan,magenta\" \"php artisan serve\" \"next dev src -p 3000\" --names=api,web --kill-others",
    "dev:api": "php artisan serve",
    "dev:web": "next dev src -p 3000",
    "build": "next build src",
    "start": "next start src -p 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "php artisan test",
    "migrate": "php artisan migrate"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "motion": "^14.12.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3"
  }
}
