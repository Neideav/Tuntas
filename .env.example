APP_NAME=Tuntas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =============================================================================
# DATABASE
# local : SQLite
# production (RDS) : uncomment PostgreSQL, isi dengan endpoint RDS kamu
# =============================================================================
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# DB_CONNECTION=pgsql
# DB_HOST=your-rds-endpoint.rds.amazonaws.com
# DB_PORT=5432
# DB_DATABASE=tuntas
# DB_USERNAME=tuntas_user
# DB_PASSWORD=secret

# =============================================================================
# SESSION, CACHE, QUEUE
# production: pertimbangkan Redis (ElastiCache) untuk cache & queue
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Redis / ElastiCache (production recommended) ---
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# =============================================================================
# STORAGE (S3)
# Untuk upload file di production, gunakan S3
# =============================================================================
# FILESYSTEM_DISK=s3
# AWS_BUCKET=tuntas-storage
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_URL=https://tuntas-storage.s3.ap-southeast-1.amazonaws.com

# =============================================================================
# MAIL — AWS SES
# EC2 ke SES: pakai IAM Role (tidak perlu ACCESS_KEY jika EC2 sudah attach role)
# local/dev  : MAIL_MAILER=log
# production : MAIL_MAILER=ses
# =============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS SES (production) ---
# MAIL_MAILER=ses
# AWS_DEFAULT_REGION=ap-southeast-1
# Jika pakai IAM Role di EC2, tidak perlu dua baris di bawah ini:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# AWS SHARED (dipakai SES + S3 + SQS jika pakai IAM User, bukan IAM Role)
# Best practice: attach IAM Role ke EC2, hapus key ini dari .env production
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1

# =============================================================================
# FRONTEND (Next.js)
# production: ganti localhost dengan domain/IP EC2 atau load balancer
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_API_URL=http://127.0.0.1:8000/api/:path*
