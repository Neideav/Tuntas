# =============================================================================
# TUNTAS — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

APP_NAME="Tuntas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_EC2_PUBLIC_IP
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING (Daily rotation in production)
# =============================================================================
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# =============================================================================
# DATABASE — MariaDB / MySQL (AWS RDS)
# =============================================================================
DB_CONNECTION=mariadb
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_DATABASE=tuntas
DB_USERNAME=admin
DB_PASSWORD=YOUR_RDS_PASSWORD

# --- AWS RDS SSL Certificate Validation ---
# Path ke Amazon RDS CA bundle di dalam Docker container: /etc/ssl/certs/global-bundle.pem
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/global-bundle.pem
DB_SSL_VERIFY_CERT=true

# =============================================================================
# SESSION & AUTHENTICATION
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum Personal Access Token & Stateful Domains
SANCTUM_STATEFUL_DOMAINS=YOUR_EC2_PUBLIC_IP,YOUR_EC2_PUBLIC_IP:3000
SANCTUM_TOKEN_EXPIRATION=10080

# =============================================================================
# NETWORKING, REVERSE PROXY & CORS
# =============================================================================
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:3000
# Comma-separated list of allowed frontend origins (no wildcard '*' when credentials enabled)
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP:3000,http://localhost:3000,http://127.0.0.1:3000
# TRUSTED_PROXIES: '*' for AWS ALB / CloudFront reverse proxy in private VPC, or specific proxy IP
TRUSTED_PROXIES="*"

# =============================================================================
# CACHE & QUEUE (Database driver with background worker)
# =============================================================================
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Redis / ElastiCache (Opsional jika ingin upgrade ke in-memory cache) ---
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# =============================================================================
# STORAGE (Local Public Disk default, AWS S3 optional)
# =============================================================================
FILESYSTEM_DISK=public

# --- AWS S3 (Opsional untuk asset uploads) ---
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=tuntas-media
# AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# MAIL — SMTP / AWS SES
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tuntas.app
MAIL_FROM_NAME="Tuntas"

# =============================================================================
# FRONTEND CONFIGURATION (Next.js)
# =============================================================================
# NEXT_PUBLIC_API_URL: default /api/v1 memanfaatkan reverse proxy Next.js rewrite
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_API_URL=http://127.0.0.1:8000/api/:path*
