APP_NAME=Tuntas
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_EC2_PUBLIC_IP
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:3000
SANCTUM_STATEFUL_DOMAINS=YOUR_EC2_PUBLIC_IP,YOUR_EC2_PUBLIC_IP:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =============================================================================
# DATABASE — AWS RDS MariaDB / MySQL
# Ganti YOUR_RDS_ENDPOINT dengan endpoint RDS kamu
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_DATABASE=tuntas
DB_USERNAME=admin
DB_PASSWORD=YOUR_DB_PASSWORD

# =============================================================================
# SESSION, CACHE, QUEUE
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Redis / ElastiCache (production recommended) ---
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# =============================================================================
# STORAGE (S3)
# =============================================================================
# FILESYSTEM_DISK=s3
# AWS_BUCKET=tuntas-storage
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_URL=https://tuntas-storage.s3.ap-southeast-1.amazonaws.com

# =============================================================================
# MAIL — AWS SES
# =============================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS SES (production) ---
# MAIL_MAILER=ses
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# FRONTEND (Next.js)
# Ganti dengan IP/domain EC2 kamu
# =============================================================================
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP/api/v1
BACKEND_API_URL=http://127.0.0.1:8000/api/:path*
