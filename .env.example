# =============================================================================
# TUNTAS — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

APP_NAME="Tuntas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =============================================================================
# URL & ROUTING (No port 3000 or 8000 in public URLs!)
# =============================================================================
# --- MODE A: Direct EC2 IP Access (HTTP) ---
APP_URL=http://EC2_PUBLIC_IP
FRONTEND_URL=http://EC2_PUBLIC_IP
CORS_ALLOWED_ORIGINS=http://EC2_PUBLIC_IP
SANCTUM_STATEFUL_DOMAINS=EC2_PUBLIC_IP,localhost,127.0.0.1
SESSION_SECURE_COOKIE=false

# --- MODE B: Custom Domain with Active SSL (HTTPS) ---
# Setelah menjalankan ./scripts/setup-ssl.sh tuntas.id admin@tuntas.id
# Ubah nilai berikut dan jalankan: docker compose exec app php artisan config:cache
# APP_URL=https://tuntas.id
# FRONTEND_URL=https://tuntas.id
# CORS_ALLOWED_ORIGINS=https://tuntas.id,https://www.tuntas.id
# SANCTUM_STATEFUL_DOMAINS=tuntas.id,www.tuntas.id,localhost,127.0.0.1
# SESSION_SECURE_COOKIE=true

# =============================================================================
# LOGGING (Daily rotation in production)
# =============================================================================
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# =============================================================================
# DATABASE — MariaDB / MySQL (AWS RDS)
# =============================================================================
DB_CONNECTION=mariadb
DB_HOST=YOUR_RDS_ENDPOINT.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=tuntas
DB_USERNAME=admin
DB_PASSWORD=YOUR_STRONG_RDS_PASSWORD

# --- AWS RDS SSL Certificate Validation ---
# Path ke Amazon RDS CA bundle di dalam Docker container: /etc/ssl/certs/global-bundle.pem
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/global-bundle.pem
DB_SSL_VERIFY_CERT=true

# =============================================================================
# SESSION & AUTHENTICATION
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_TOKEN_EXPIRATION=10080

# =============================================================================
# REVERSE PROXY TRUST (Docker Bridge & AWS ALB)
# =============================================================================
TRUSTED_PROXIES="*"

# =============================================================================
# CACHE & QUEUE (Database driver with background worker)
# =============================================================================
CACHE_STORE=database
QUEUE_CONNECTION=database

# =============================================================================
# STORAGE (Local Public Disk default, AWS S3 optional)
# =============================================================================
FILESYSTEM_DISK=public

# =============================================================================
# MAIL — SMTP / AWS SES
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tuntas.app
MAIL_FROM_NAME="Tuntas"

# =============================================================================
# FRONTEND CONFIGURATION (Next.js)
# =============================================================================
NEXT_PUBLIC_APP_NAME="Tuntas"
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1
BACKEND_API_URL=http://127.0.0.1:8000/api/:path*
